# Copiez ce fichier en ".env" à la racine du projet et renseignez vos propres valeurs.
# Ne committez jamais votre fichier ".env" (il est déjà ignoré par git).

# Clé API Anthropic (Claude), utilisée par le serveur pour l'Assistant IA.
ANTHROPIC_API_KEY=

# Chaîne de connexion PostgreSQL (depuis Supabase : Project Settings > Database > Connection string).
# IMPORTANT : utilisez le "Session pooler" (pas la "Direct connection"). La connexion directe
# (db.xxxxx.supabase.co:5432) est en IPv6 uniquement et échouera au démarrage sur Fly.io, Railway
# et Render, qui ne supportent pas les sorties réseau IPv6 vers ces adresses — même si tout
# fonctionne en local. Le pooler (aws-0-xxxxx.pooler.supabase.com:5432) est compatible IPv4 et
# fonctionne partout. Notez que le nom d'utilisateur devient "postgres.VOTRE_REF_PROJET" (avec le
# suffixe) au lieu de simplement "postgres" avec le pooler.
# Exemple : postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Port du serveur API local (optionnel, 8787 par défaut). Render définit sa propre valeur automatiquement.
PORT=8787

# URL du projet Supabase (Project Settings > API > Project URL), utilisée pour l'envoi de
# fichiers vers Supabase Storage (bucket privé "client-files" — à créer manuellement dans
# Storage si ce n'est pas déjà fait).
# Exemple : https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Clé "service_role" du projet Supabase (Project Settings > API > Project API keys). Cette clé
# contourne les règles de sécurité (Row Level Security) : elle ne doit exister QUE côté serveur,
# jamais être exposée au frontend ni committée.
SUPABASE_SERVICE_ROLE_KEY=

# Clé API partagée protégeant toute l'API (server/index.js) : chaque requête (sauf GET /api/health)
# doit envoyer l'en-tête "Authorization: Bearer <API_KEY>", sinon elle est refusée avec 401.
# Choisissez une valeur longue et aléatoire. En production (Fly.io), définissez-la via :
#   fly secrets set API_KEY="votre-valeur-secrete"
# Le frontend doit recevoir la même valeur via VITE_API_KEY (voir plus bas) pour pouvoir appeler l'API.
API_KEY=

# Doit être IDENTIQUE à API_KEY ci-dessus — c'est la valeur que le frontend (Vite) envoie dans
# l'en-tête Authorization de chaque appel API. Contrairement aux autres variables VITE_*, celle-ci
# finit dans le bundle JS envoyé au navigateur : ce n'est donc un vrai secret que dans la mesure où
# l'app n'a qu'un seul utilisateur de confiance (Rachid) — elle empêche un tiers qui tombe sur
# l'URL de l'API de l'appeler directement, pas un utilisateur qui inspecterait le site lui-même.
VITE_API_KEY=
