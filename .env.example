# Copiez ce fichier en ".env" à la racine du projet et renseignez vos propres valeurs.
# Ne committez jamais votre fichier ".env" (il est déjà ignoré par git).

# Clé API Anthropic (Claude), utilisée par le serveur pour l'Assistant IA.
ANTHROPIC_API_KEY=

# Chaîne de connexion PostgreSQL (depuis Supabase : Project Settings > Database > Connection string).
# IMPORTANT : utilisez le "Session pooler" (pas la "Direct connection"). La connexion directe
# (db.xxxxx.supabase.co:5432) est en IPv6 uniquement et échouera au démarrage sur Fly.io, Railway
# et Render, qui ne supportent pas les sorties réseau IPv6 vers ces adresses — même si tout
# fonctionne en local. Le pooler (aws-0-xxxxx.pooler.supabase.com:5432) est compatible IPv4 et
# fonctionne partout. Notez que le nom d'utilisateur devient "postgres.VOTRE_REF_PROJET" (avec le
# suffixe) au lieu de simplement "postgres" avec le pooler.
# Exemple : postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Port du serveur API local (optionnel, 8787 par défaut). Render définit sa propre valeur automatiquement.
PORT=8787
